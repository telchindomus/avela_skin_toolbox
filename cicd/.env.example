# cicd settings for avela_skin_toolbox (copy to cicd/.env; .env is not committed). Everything here has a default.
# The toolbox repository test_unit.sh clones (default: this checkout's origin remote).
REPO_URL=
# The firmware whose official skins the test renders, and its tag or branch (default: GitHub, main).
FIRMWARE_URL=https://github.com/telchindomus/avela_firmware.git
FIRMWARE_TAG=main
# Where the scripts work (default: build/ in this checkout): the fresh clones go to $BUILD_DIR/clones/ (CLONES_DIR
# overrides that).
BUILD_DIR=
