# Defaults for render.sh (copy to .env and adjust; relative paths are relative to this folder): the firmware
# checkout the components and LovyanGFX come from, the skin rendered without --skin, and where renders go
# (<AVELA_OUT>/<skin folder name>).
AVELA_FIRMWARE=../avela_firmware
AVELA_SKIN=../avela_firmware/components/avela_skin_piccolo
AVELA_OUT=renders
