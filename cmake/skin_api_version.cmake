# avela_check_skin_api_version(<skin> <skin API version> <specifier>): stops unless the version meets every clause of
# the pip-style specifier (comma-separated: >=, >, <=, <, ==, !=), the same check the firmware's top-level
# CMakeLists.txt makes against its supported_skin_api_versions.
function(avela_check_skin_api_version skin skin_api_version specifier)
    string(REPLACE "," ";" clauses "${specifier}")
    foreach(clause IN LISTS clauses)
        string(STRIP "${clause}" clause)
        if(NOT clause MATCHES "^(>=|<=|==|!=|>|<) *([0-9]+(\\.[0-9]+)*)$")
            message(FATAL_ERROR "supported skin API versions: can't read \"${clause}\"")
        endif()
        set(operator "${CMAKE_MATCH_1}")
        set(version "${CMAKE_MATCH_2}")
        # the skin's API version compared with the clause's: -1 older, 0 equal, 1 newer; each operator allows some
        if(skin_api_version VERSION_LESS version)
            set(order -1)
        elseif(skin_api_version VERSION_EQUAL version)
            set(order 0)
        else()
            set(order 1)
        endif()
        if(operator STREQUAL ">=")
            set(allowed_orders 0 1)
        elseif(operator STREQUAL ">")
            set(allowed_orders 1)
        elseif(operator STREQUAL "<=")
            set(allowed_orders -1 0)
        elseif(operator STREQUAL "<")
            set(allowed_orders -1)
        elseif(operator STREQUAL "==")
            set(allowed_orders 0)
        else()  # !=
            set(allowed_orders -1 1)
        endif()
        if(NOT order IN_LIST allowed_orders)
            message(FATAL_ERROR "skin ${skin} implements skin API ${skin_api_version}; this toolbox's scenes cover "
                                "${specifier}. Use a toolbox release for that skin API.")
        endif()
    endforeach()
endfunction()
